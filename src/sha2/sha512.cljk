;; ── the compression function ─────────────────────────────────────────────────

(defn- big-sigma0 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  (xor64 (xor64 (rotr64 x 28) (rotr64 x 34)) (rotr64 x 39)))
(defn- big-sigma1 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  (xor64 (xor64 (rotr64 x 14) (rotr64 x 18)) (rotr64 x 41)))
(defn- small-sigma0 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  (xor64 (xor64 (rotr64 x 1) (rotr64 x 8)) (shr64 x 7)))
(defn- small-sigma1 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  (xor64 (xor64 (rotr64 x 19) (rotr64 x 61)) (shr64 x 6)))
(defn- ch [#?@(:kotoba [x :i64 y :i64 z :i64] :default [x y z])] #?@(:kotoba [:i64])
  (xor64 (and64 x y) (and64 (not64 x) z)))
(defn- maj [#?@(:kotoba [x :i64 y :i64 z :i64] :default [x y z])] #?@(:kotoba [:i64])
  (xor64 (xor64 (and64 x y) (and64 x z)) (and64 y z)))

#?(:kotoba
   ;; the 80-word message schedule of the 128-byte block at byte offset `off` of `padded`
   (defn- schedule [padded :vector-i64 off :i64] :vector-i64
     (loop [t 0 w (vector-i64)]
       (if (= t 80)
         w
         (if (< t 16)
           (let [o (+ off (* 8 t))]
             (recur (+ t 1)
                    (vector-conj
                     w
                     (bit-or
                      (bit-or (bit-or (i64-shift-left (vector-at padded o) 56)
                                      (i64-shift-left (vector-at padded (+ o 1)) 48))
                              (bit-or (i64-shift-left (vector-at padded (+ o 2)) 40)
                                      (i64-shift-left (vector-at padded (+ o 3)) 32)))
                      (bit-or (bit-or (i64-shift-left (vector-at padded (+ o 4)) 24)
                                      (i64-shift-left (vector-at padded (+ o 5)) 16))
                              (bit-or (i64-shift-left (vector-at padded (+ o 6)) 8)
                                      (vector-at padded (+ o 7))))))))
           (recur (+ t 1)
                  (vector-conj w (add64 (add64 (small-sigma1 (vector-at w (- t 2)))
                                               (vector-at w (- t 7)))
                                        (add64 (small-sigma0 (vector-at w (- t 15)))
                                               (vector-at w (- t 16)))))))))))

#?(:kotoba
   ;; the working variables after the 80 rounds
   (defn- rounds [w :vector-i64 state :vector-i64] :vector-i64
     (let [k (k-table)]
       (loop [t 0 v state]
         (if (= t 80)
           v
           (let [a (vector-at v 0) b (vector-at v 1) c (vector-at v 2) d (vector-at v 3)
                 e (vector-at v 4) f (vector-at v 5) g (vector-at v 6) hh (vector-at v 7)
                 t1 (add64 (add64 (add64 hh (big-sigma1 e))
                                  (add64 (ch e f g) (vector-at k t)))
                           (vector-at w t))
                 t2 (add64 (big-sigma0 a) (maj a b c))]
             (recur (+ t 1)
                    (vector-i64 (add64 t1 t2) a b c (add64 d t1) e f g))))))))

(defn- compress
  [#?@(:kotoba [h :vector-i64 padded :vector-i64 off :i64] :default [h block])]
  #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [end (rounds (schedule padded off) h)]
       (vector-i64 (add64 (vector-at h 0) (vector-at end 0))
                   (add64 (vector-at h 1) (vector-at end 1))
                   (add64 (vector-at h 2) (vector-at end 2))
                   (add64 (vector-at h 3) (vector-at end 3))
                   (add64 (vector-at h 4) (vector-at end 4))
                   (add64 (vector-at h 5) (vector-at end 5))
                   (add64 (vector-at h 6) (vector-at end 6))
                   (add64 (vector-at h 7) (vector-at end 7))))
     :default
     (let [w (loop [t 16
                    w (mapv (fn [i]
                              (let [o (* 8 i)
                                    b (fn [j] (nth block (+ o j)))]
                                [(u32 (+ (* 16777216 (b 0)) (* 65536 (b 1)) (* 256 (b 2)) (b 3)))
                                 (u32 (+ (* 16777216 (b 4)) (* 65536 (b 5)) (* 256 (b 6)) (b 7)))]))
                            (range 16))]
                (if (= t 80)
                  w
                  (recur (inc t)
                         (conj w (add64 (add64 (small-sigma1 (nth w (- t 2))) (nth w (- t 7)))
                                        (add64 (small-sigma0 (nth w (- t 15))) (nth w (- t 16))))))))
           end (reduce
                (fn [[a b c d e f g hh] t]
                  (let [t1 (add64 (add64 (add64 hh (big-sigma1 e))
                                         (add64 (ch e f g) (nth k t)))
                                  (nth w t))
                        t2 (add64 (big-sigma0 a) (maj a b c))]
                    [(add64 t1 t2) a b c (add64 d t1) e f g]))
                (vec h)
                (range 80))]
       (mapv add64 h end))))

;; ── padding and the public surface ───────────────────────────────────────────

(def ^:private block-bytes 128)

#?(:kotoba
   (defn- zeros-onto [v :vector-i64 n :i64] :vector-i64
     (loop [i 0 out v]
       (if (>= i n) out (recur (+ i 1) (vector-conj out 0))))))

#?(:kotoba
   (defn- append-all [a :vector-i64 b :vector-i64] :vector-i64
     (let [n (vector-count b)]
       (loop [i 0 out a]
         (if (>= i n) out (recur (+ i 1) (vector-conj out (vector-at b i))))))))

(defn- ->ints [#?@(:kotoba [data :vector-i64] :default [data])] #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [n (vector-count data)]
       (loop [i 0 out (vector-i64)]
         (if (>= i n) out (recur (+ i 1) (vector-conj out (bit-and (vector-at data i) 0xFF))))))
     :default (mapv #(bit-and (int %) 0xFF) (seq data))))

(defn- pad
  "FIPS 180-4 §5.1.2: a 1 bit, zeros, then the length as a 128-BIT big-endian
  count of bits.

  The length field is sixteen bytes here, not eight. Using SHA-256's width
  gives a digest that is right for every input anyone would hash and wrong
  past 2^61 bytes, which is the kind of defect no test data reveals."
  [#?@(:kotoba [bs :vector-i64] :default [bs])] #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [n (vector-count bs)
           bits (* 8 n)
           r (- (+ n 17) (* block-bytes (quot (+ n 17) block-bytes)))
           pad-len (if (= r 0) 1 (+ 1 (- block-bytes r)))
           body (zeros-onto (zeros-onto (vector-conj bs 0x80) (- pad-len 1)) 8)]
       (vector-conj
        (vector-conj
         (vector-conj
          (vector-conj
           (vector-conj
            (vector-conj
             (vector-conj
              (vector-conj body (bit-and (u64-shift-right bits 56) 0xFF))
              (bit-and (u64-shift-right bits 48) 0xFF))
             (bit-and (u64-shift-right bits 40) 0xFF))
            (bit-and (u64-shift-right bits 32) 0xFF))
           (bit-and (u64-shift-right bits 24) 0xFF))
          (bit-and (u64-shift-right bits 16) 0xFF))
         (bit-and (u64-shift-right bits 8) 0xFF))
        (bit-and bits 0xFF)))
     :default
     (let [n (count bs)
           bits (* 8 n)
           pad-len (let [r (mod (+ n 17) block-bytes)]
                     (if (zero? r) 1 (+ 1 (- block-bytes r))))
           ;; Only the low eight bytes can be non-zero: a length past 2^64 bits
           ;; is not reachable by any caller either runtime can hold.
           len16 (into (vec (repeat 8 0))
                       (mapv (fn [i] (bit-and (quot bits (reduce * 1 (repeat (- 7 i) 256))) 0xFF))
                             (range 8)))]
       (vec (concat bs [0x80] (repeat (dec pad-len) 0) len16)))))

#?(:kotoba
   (defn- fold-blocks [initial :vector-i64 padded :vector-i64] :vector-i64
     (let [n (vector-count padded)]
       (loop [i 0 h initial]
         (if (>= i n)
           h
           (recur (+ i block-bytes) (compress h padded i)))))))

#?(:kotoba
   ;; the first `out-bytes` bytes (a multiple of 8) of the chaining words, big-endian
   (defn- words->bytes [state :vector-i64 out-bytes :i64] :vector-i64
     (let [words (quot out-bytes 8)]
       (loop [j 0 out (vector-i64)]
         (if (>= j words)
           out
           (let [x (vector-at state j)]
             (recur (+ j 1)
                    (vector-conj
                     (vector-conj
                      (vector-conj
                       (vector-conj
                        (vector-conj
                         (vector-conj
                          (vector-conj
                           (vector-conj out (bit-and (u64-shift-right x 56) 0xFF))
                           (bit-and (u64-shift-right x 48) 0xFF))
                          (bit-and (u64-shift-right x 40) 0xFF))
                         (bit-and (u64-shift-right x 32) 0xFF))
                        (bit-and (u64-shift-right x 24) 0xFF))
                       (bit-and (u64-shift-right x 16) 0xFF))
                      (bit-and (u64-shift-right x 8) 0xFF))
                     (bit-and x 0xFF)))))))))

(defn- digest
  [#?@(:kotoba [initial :vector-i64 data :vector-i64 out-bytes :i64] :default [initial data out-bytes])]
  #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (words->bytes (fold-blocks initial (pad (->ints data))) out-bytes)
     :default
     (let [padded (pad (->ints data))
           h (reduce (fn [h i] (compress h (subvec padded (* i block-bytes)
                                                   (* (inc i) block-bytes))))
                     initial
                     (range (quot (count padded) block-bytes)))]
       (vec (take out-bytes
                  (mapcat (fn [[hi lo]]
                            [(bit-and (quot hi 16777216) 0xFF) (bit-and (quot hi 65536) 0xFF)
                             (bit-and (quot hi 256) 0xFF) (bit-and hi 0xFF)
                             (bit-and (quot lo 16777216) 0xFF) (bit-and (quot lo 65536) 0xFF)
                             (bit-and (quot lo 256) 0xFF) (bit-and lo 0xFF)])
                          h))))))

(defn sha512 [#?@(:kotoba [data :vector-i64] :default [data])] #?@(:kotoba [:vector-i64])
  #?(:kotoba (digest (iv) data 64) :default (digest iv data 64)))
(defn sha384 [#?@(:kotoba [data :vector-i64] :default [data])] #?@(:kotoba [:vector-i64])
  #?(:kotoba (digest (iv-384) data 48) :default (digest iv-384 data 48)))

(defn hex [#?@(:kotoba [bs :vector-i64] :default [bs])] #?@(:kotoba [:string])
  #?(:kotoba
     (let [n (vector-count bs)]
       (loop [i 0 out ""]
         (if (>= i n)
           out
           (let [b (bit-and (vector-at bs i) 0xFF)]
             (recur (+ i 1)
                    (string-concat
                     (string-concat out (string-substring "0123456789abcdef" (u64-shift-right b 4) (+ 1 (u64-shift-right b 4))))
                     (string-substring "0123456789abcdef" (bit-and b 15) (+ 1 (bit-and b 15)))))))))
     :default
     (apply str (map (fn [b] (let [b (bit-and (int b) 0xFF)
                                   s #?(:clj (Integer/toString b 16) :cljs (.toString b 16))]
                               (if (= 1 (count s)) (str "0" s) s)))
                     bs))))

(defn sha512-hex [#?@(:kotoba [data :vector-i64] :default [data])] #?@(:kotoba [:string])
  (hex (sha512 data)))
(defn sha384-hex [#?@(:kotoba [data :vector-i64] :default [data])] #?@(:kotoba [:string])
  (hex (sha384 data)))

#?(:kotoba
   (defn- xor-each [v :vector-i64 x :i64] :vector-i64
     (let [n (vector-count v)]
       (loop [i 0 out (vector-i64)]
         (if (>= i n) out (recur (+ i 1) (vector-conj out (bit-xor (vector-at v i) x))))))))

(defn hmac-sha512
  "HMAC-SHA-512, FIPS 198-1.

  The block is 128 bytes here, not 64. Using SHA-256's block size produces a
  MAC that is self-consistent and disagrees with every other implementation."
  [#?@(:kotoba [key :vector-i64 message :vector-i64] :default [key message])]
  #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [k1 (->ints key)
           k2 (if (> (vector-count k1) block-bytes) (sha512 k1) k1)
           k3 (zeros-onto k2 (- block-bytes (vector-count k2)))
           ipad (xor-each k3 0x36)
           opad (xor-each k3 0x5C)]
       (sha512 (append-all opad (sha512 (append-all ipad (->ints message))))))
     :default
     (let [k (->ints key)
           k (if (> (count k) block-bytes) (sha512 k) k)
           k (vec (concat k (repeat (- block-bytes (count k)) 0)))
           ipad (mapv #(bit-xor % 0x36) k)
           opad (mapv #(bit-xor % 0x5C) k)]
       (sha512 (concat opad (sha512 (concat ipad (->ints message))))))))

(defn hmac-sha512-hex [#?@(:kotoba [key :vector-i64 message :vector-i64] :default [key message])]
  #?@(:kotoba [:string])
  (hex (hmac-sha512 key message)))

(defn hmac-sha384
  "HMAC-SHA-384, FIPS 198-1.

  The block is 128 bytes, the same as SHA-512's -- SHA-384 is SHA-512 with a
  different IV and a truncated output, and the block size does not change with
  the truncation. Deriving it from the 48-byte digest instead would produce a
  self-consistent MAC that disagrees with every other implementation.

  An over-long key is hashed with **SHA-384**, not SHA-512: the key
  transformation uses the same hash as the MAC, so a 131-byte key becomes 48
  bytes here and 64 bytes in `hmac-sha512`. RFC 4231's test case 6 is exactly
  that case, and it is asserted."
  [#?@(:kotoba [key :vector-i64 message :vector-i64] :default [key message])]
  #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [k1 (->ints key)
           k2 (if (> (vector-count k1) block-bytes) (sha384 k1) k1)
           k3 (zeros-onto k2 (- block-bytes (vector-count k2)))
           ipad (xor-each k3 0x36)
           opad (xor-each k3 0x5C)]
       (sha384 (append-all opad (sha384 (append-all ipad (->ints message))))))
     :default
     (let [k (->ints key)
           k (if (> (count k) block-bytes) (sha384 k) k)
           k (vec (concat k (repeat (- block-bytes (count k)) 0)))
           ipad (mapv #(bit-xor % 0x36) k)
           opad (mapv #(bit-xor % 0x5C) k)]
       (sha384 (concat opad (sha384 (concat ipad (->ints message))))))))

(defn hmac-sha384-hex [#?@(:kotoba [key :vector-i64 message :vector-i64] :default [key message])]
  #?@(:kotoba [:string])
  (hex (hmac-sha384 key message)))
